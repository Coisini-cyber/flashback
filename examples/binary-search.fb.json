{"version":1,"tool":"flashback","createdAt":"2026-10-29T05:06:57.564Z","node":"v22.23.2","cwd":"D:\\project","entry":"examples/binary-search.js","args":[],"breakAt":null,"watches":[],"files":{"examples/binary-search.js":{"source":"// A classic off-by-one bug: the loop stops one comparison too early.\n// Run: flashback run examples/binary-search.js\nfunction binarySearch(sorted, target) {\n  let lo = 0;\n  let hi = sorted.length - 1;\n\n  while (lo < hi) {\n    const mid = Math.floor((lo + hi) / 2);\n    if (sorted[mid] === target) return mid;\n    if (sorted[mid] < target) lo = mid + 1;\n    else hi = mid - 1;\n  }\n\n  return -1;\n}\n\nconst sorted = [1, 3, 5, 7, 9, 11, 13, 15];\nconst target = 15;\nconst index = binarySearch(sorted, target);\n\nconsole.log(`searching for ${target} in [${sorted}]`);\nconsole.log(`result: ${index}`);\nconsole.log(index === sorted.length - 1 ? \"ok\" : \"BUG: element not found\");\n","lang":"js"}},"steps":[{"file":"examples/binary-search.js","line":17,"column":16,"fn":"<anonymous>","t":124,"stack":[{"file":"examples/binary-search.js","line":17,"column":16,"fn":"<anonymous>","scopes":[]}],"watches":[]},{"file":"examples/binary-search.js","line":18,"column":16,"fn":"<anonymous>","t":124,"stack":[{"file":"examples/binary-search.js","line":18,"column":16,"fn":"<anonymous>","scopes":[]}],"watches":[]},{"file":"examples/binary-search.js","line":19,"column":15,"fn":"<anonymous>","t":125,"stack":[{"file":"examples/binary-search.js","line":19,"column":15,"fn":"<anonymous>","scopes":[]}],"watches":[]},{"file":"examples/binary-search.js","line":4,"column":12,"fn":"binarySearch","t":125,"stack":[{"file":"examples/binary-search.js","line":4,"column":12,"fn":"binarySearch","scopes":[{"type":"local","name":"binarySearch","vars":[{"name":"sorted","value":{"t":"array","c":"Array","d":"Array(8)","p":[["0","1"],["1","3"],["2","5"],["3","7"],["4","9"],["5","11"],["6","13"],["7","15"]]}},{"name":"target","value":{"t":"number","v":15}}]}]},{"file":"exampl